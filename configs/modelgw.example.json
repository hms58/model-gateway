{
    "version": 1,
    "listen": ":8080",
    "admin_token_sha256": "",
    "data_dir": "./data",
    "routing": {
        "max_attempts": 4,
        "cooldown": {
            "base": "2s",
            "max": "60s",
            "fail_threshold": 3,
            "open_duration": "5m",
            "unavailable_duration": "10m",
            "status_rules": [
                { "status": 400, "threshold": 5, "duration": "60s" },
                { "status": 502, "threshold": 3, "duration": "60s" }
            ]
        },
        "prefer_last_ok": true,
        "sticky": {
            "enabled": true,
            "ttl": "30m"
        }
    },
    "probe": {
        "enabled": true,
        "interval": "60s",
        "min_gap": "30s"
    },
    "logging": {
        "dir": "./logs",
        "retention_days": 14,
        "max_file_mb": 64
    },
    "products": [
        {
            "id": "upstream-a",
            "name": "上游 A",
