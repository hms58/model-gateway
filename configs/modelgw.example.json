            "api_key": "sk-****",
            "enabled": true,
            "timeout": {
                "connect": "5s",
                "first_byte": "30s",
                "total": "300s"
            },
            "headers": {},
            "chat_path": "/v1/chat/completions",
            "models_path": "/v1/models",
            "proxy": {
                "enabled": false,
                "url": ""
            },
            "disabled_models": [],
            "note": ""
